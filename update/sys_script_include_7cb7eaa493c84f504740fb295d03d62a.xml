    needit_ex_isDatePast: function(strDate) {
        var rightNow = new GlideDateTime();
        var testDate = new GlideDateTime(strDate);
        if (testDate.before(rightNow)) {
            return true;
        } else {
            return false;
        }
    },

	needit_ex_isDateToday: function(strDate){
		var today=new GlideDateTime();
		var dateToday=new GlideDateTime(strDate);
		
		return today.getDate().getValue()== dateToday.getDate().getValue();
	},

    type: 'needit_ex_NeedItUtils'
};]]></script>
