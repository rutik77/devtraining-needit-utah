        <script><![CDATA[var needit_ex_NeeditUtils = Class.create();
needit_ex_NeeditUtils.prototype = {
    initialize: function() {},

    needit_ex_isDatePast: function(strDate) {
        var rightnow = new GlideDateTime();
        var testdate = new GlideDateTime(strDate);
		testdate.setValue(strDate);
        if (testdate.before(rightnow)) {
            return true;
        } else {
            return false;
        }
    },
    type: 'needit_ex_NeeditUtils'
};]]></script>
